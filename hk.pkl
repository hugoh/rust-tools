amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v3.1.3/hk-config@3.1.3#/base.pkl" as Base

min_hk_version = Base.min_hk_version

local linters = new Mapping<String, Step> {
  ...Base.base
  ...Base.python
  // ty needs the test dependencies importable to resolve copier, pytest and yaml
  ["ty"] = (Builtins.ty) {
    check = "uv venv --quiet --clear --python 3.12 .cache/ty-venv && uv pip install --quiet --python .cache/ty-venv -r test/render-check-requirements.txt && ty check --python .cache/ty-venv {{files}}"
  }
}

steps = linters

hooks {
  ["pre-commit"] {
    stash = "git"
  }
  ["commit-msg"] {
    steps = new Mapping<String, Step> {
      ["cocogitto_commit_msg"] = Builtins.cocogitto_commit_msg
    }
  }
}
